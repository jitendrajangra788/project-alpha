# CareConnect environment
APP_NAME=CareConnect
APP_ENV=development
APP_VERSION=1.0.0
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:4200
TRUSTED_HOSTS=*
LOG_LEVEL=INFO
ENABLE_DOCS=
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true

# Used by docker-compose.prod.yml
POSTGRES_DB=careconnect
POSTGRES_USER=careconnect
POSTGRES_PASSWORD=change-me-strong-db-password
WEB_PORT=80

# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://careconnect:careconnect@localhost:5432/careconnect
DATABASE_URL_SYNC=postgresql+psycopg://careconnect:careconnect@localhost:5432/careconnect
# Local fallback when Docker/Postgres is unavailable:
# DATABASE_URL=sqlite+aiosqlite:///./careconnect.db
# DATABASE_URL_SYNC=sqlite:///./careconnect.db
# Then run: python scripts/bootstrap_local.py


# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_OPTIONAL=true

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Seed admin
SEED_ADMIN_EMAIL=admin@careconnect.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_MOBILE=9999999999

# Frontend
FRONTEND_URL=http://localhost:4200

# Razorpay (leave empty / mock=true for local mock payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true
PLATFORM_COMMISSION_PERCENT=10
